<Window x:Class="RevitDetailingTool.UI.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anotação Automática" Height="340" Width="320" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="12">
        <TextBlock Text="Categorias para tag automática:" FontWeight="Bold" Margin="0,0,0,8"/>
        <CheckBox x:Name="ChkWalls" Content="Paredes" IsChecked="True" Margin="0,2"/>
        <CheckBox x:Name="ChkDoors" Content="Portas" IsChecked="True" Margin="0,2"/>
        <CheckBox x:Name="ChkWindows" Content="Janelas" IsChecked="True" Margin="0,2"/>
        <CheckBox x:Name="ChkFloors" Content="Pisos" Margin="0,2"/>
        <CheckBox x:Name="ChkRooms" Content="Ambientes" Margin="0,2"/>
        <Separator Margin="0,8"/>
        <CheckBox x:Name="ChkDimensions" Content="Criar linha de cotas (selecione 2 pontos após fechar esta janela)" Margin="0,2"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Aplicar" Width="90" Click="Apply_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
