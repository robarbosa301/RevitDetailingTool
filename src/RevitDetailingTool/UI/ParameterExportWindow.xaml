<Window x:Class="RevitDetailingTool.UI.ParameterExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Parâmetros" Height="480" Width="380" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Categoria:" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="CategoryCombo" Width="220" SelectionChanged="CategoryCombo_SelectionChanged"/>
        </StackPanel>

        <CheckBox x:Name="ChkActiveViewOnly" Grid.Row="1" Content="Somente elementos visíveis na vista ativa" Margin="0,0,0,8"/>

        <GroupBox Header="Parâmetros a exportar" Grid.Row="2">
            <ListBox x:Name="ParametersList" SelectionMode="Extended"/>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Exportar" Width="90" Click="Export_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
