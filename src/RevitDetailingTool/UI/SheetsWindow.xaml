<Window x:Class="RevitDetailingTool.UI.SheetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Criar Prancha" Height="480" Width="420" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Carimbo:" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="TitleBlockCombo" Width="260" DisplayMemberPath="Name"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Número:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="SheetNumberBox" Width="260" Text="A-001"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Nome:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="SheetNameBox" Width="260" Text="PRANCHA DE DETALHES"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Colunas:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="ColumnsBox" Width="60" Text="2"/>
        </StackPanel>

        <GroupBox Header="Vistas disponíveis (sem prancha)" Grid.Row="4" Margin="0,0,0,8">
            <ListBox x:Name="ViewsList" SelectionMode="Extended" DisplayMemberPath="Name"/>
        </GroupBox>

        <StackPanel Orientation="Horizontal" Grid.Row="5" HorizontalAlignment="Right">
            <Button Content="Cancelar" Width="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Criar" Width="90" Click="Create_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
